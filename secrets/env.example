# Copy to secrets/env (gitignored) and fill in. Load before running:
#   set -a; . ./secrets/env; set +a; ./gm-screen
#
# The Anthropic key powers ONLY /api/parse-character (character import).
# Repo is public — never commit the real key. Keep it here or in the host's
# systemd EnvironmentFile / secret manager.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# PORT=8777
# PARSE_MODEL=claude-opus-4-8
# GM_WEB_DIR=./web
